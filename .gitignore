__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Notebooks
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# OS
.DS_Store
Thumbs.db
